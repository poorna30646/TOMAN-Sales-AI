# =====================================================
# TOMAN project Git ignore rules
# =====================================================

# Local environment files and credentials
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/.envrc
**/*.local
**/*.local.*
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.ovpn
**/service-account*.json
**/firebase*.json
**/google-services.json
**/google-services*.json
**/*.token
**/*credentials*
**/*secret*
**/*api-key*
**/*apikey*
**/local.properties
!**/local.properties.example
**/.xcode.env.local
**/*.p8

# Build outputs, caches, and generated files
**/node_modules/
**/dist/
**/build/
**/coverage/
**/target/
**/out/
**/.gradle/
**/.idea/
**/.vscode/
**/.cxx/
**/.cache/
**/.tmp/
**/tmp/
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/*.apk
**/*.aab
**/*.ipa
**/*.class
**/*.hprof
**/*.iml
**/*.xcuserstate
**/.expo/
**/.metro-health-check*
**/DerivedData/
**/Pods/
**/android/app/build/
**/android/build/
**/android/.gradle/
**/ios/build/
**/ios/DerivedData/
**/ios/Pods/
**/android/local.properties
**/mobile-app/android/local.properties

# Operating system/editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Runtime and local support folders
backend/.runtime-logs/
backend/**/.runtime-logs/

# Keep example files and required templates tracked
!backend/.env.example
!mobile-app/ios/.xcode.env
