<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>ai.toman</groupId>
    <artifactId>toman-sales-ai-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TOMAN Sales AI Backend</name>
    <description>Microservice platform for TOMAN Sales AI</description>

    <modules>
        <module>platform/common-contracts</module>
        <module>platform/config-service</module>
        <module>platform/discovery-service</module>
        <module>platform/api-gateway</module>
        <module>services/auth-service</module>
        <module>services/workspace-service</module>
        <module>services/ingestion-service</module>
        <module>services/jarvis-service</module>
        <module>services/notification-service</module>
    </modules>

    <!--
      Service module reservations. They deliberately remain inactive until each
      independently deployable service owns its POM and source tree.

        <module>services/workflow-service</module>
        <module>services/integration-service</module>
    -->

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.4</spring-cloud.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
