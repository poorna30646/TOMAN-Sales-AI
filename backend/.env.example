# Local development only. Copy this file to .env and never commit the copy.
# Replace every placeholder below with your own local-only values before running the stack.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_APP_PASSWORD=change_me
MYSQL_PORT=3306

# Generate unique values before starting the protected gateway routes.
# TOMAN_AUTH_JWT_SECRET must be Base64-safe and at least 32 random bytes.
TOMAN_AUTH_JWT_SECRET=replace_with_base64_32_byte_secret
TOMAN_GATEWAY_INTERNAL_KEY=replace_with_gateway_internal_key
NOTIFICATION_INTERNAL_API_KEY=replace_with_notification_internal_key

# SMTP is disabled by default. Set SMTP_ENABLED=true only after filling every
# field below with credentials from your SMTP provider. Never put these values
# in the React Native app or commit the real .env file.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME=TOMAN Sales AI
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
AUTH_VERIFICATION_EXPOSE_CODE=false

# Meta is the only model provider supported by Jarvis. Leave the API key blank
# to run the platform without AI calls; Jarvis will safely report configuration
# blocked instead of fabricating a plan.
META_AI_BASE_URL=https://api.meta.ai/v1
META_AI_API_KEY=replace_with_meta_ai_api_key
META_AI_MODEL=muse-spark-1.3
META_AI_ENABLED=true

# ElevenLabs voice is optional. The mobile app never receives this key.
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
ELEVENLABS_VOICE_ID=replace_with_voice_id
ELEVENLABS_MODEL_ID=replace_with_model_id

# Provider OAuth is server-side only. Every redirect URI must be registered
# with the relevant provider and point to a public HTTPS callback endpoint.
# Do not put any of these values in the React Native app.
TOMAN_PUBLIC_BASE_URL=http://localhost:5000
META_GRAPH_API_VERSION=v24.0
META_APP_ID=replace_with_meta_app_id
META_APP_SECRET=replace_with_meta_app_secret
META_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/meta/callback
WHATSAPP_ACCESS_TOKEN=replace_with_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace_with_whatsapp_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_whatsapp_webhook_verify_token
WHATSAPP_APP_SECRET=replace_with_whatsapp_app_secret

GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=replace_with_google_ads_developer_token
GOOGLE_ADS_CUSTOMER_ID=replace_with_google_ads_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=replace_with_google_ads_login_customer_id

# Local internal addresses. These are server configuration, never mobile-app
# configuration or credentials.
WORKSPACE_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8087
DOCUMENT_STORAGE_ROOT=./runtime/toman-ingestion-files
